{
  "name": "freee-cli",
  "version": "0.1.0",
  "description": "Unofficial command-line interface for the freee public API",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    "./reader": {
      "types": "./dist/src/reader.d.ts",
      "default": "./dist/src/reader.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "freee": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "runtime-oauth-exec": "tsx src/commands/auth/runtime-oauth-exec.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
